{
  "name": "mint-table",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:mint": "vue-cli-service build --target wc --name es-list \"src/es-list.vue\" && cp \"dist/es-list.min.js\" ../MintHCM/include/ESListView/eslist-view.min.js",
